  "faqs": [
    {
      "q": "What makes a tile free to match in Mahjong Solitaire?",
      "a": "A tile is free if nothing is resting directly or partially on top of it, and at least one lateral side (left or right) is completely open with no touching neighbor on the same tier."
    },
    {
      "q": "Can Flowers and Seasons be matched together?",
      "a": "Yes! Any Flower tile can match with any other Flower tile, and any Season tile can match with any Season tile."
    },
    {
      "q": "What happens if there are no more available moves?",
      "a": "You can use the Shuffle button to redistribute the remaining unremoved tiles without losing your score or progress."
    }
