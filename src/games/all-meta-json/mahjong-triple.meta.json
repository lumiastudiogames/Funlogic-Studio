  "faqs": [
    {
      "q": "How does the bottom tray work in Mahjong Triple?",
      "a": "You have 7 slots in your holding tray. When you tap an unblocked tile, it slides into the tray. Gathering 3 identical tiles instantly removes them."
    },
    {
      "q": "How can I lose the game?",
      "a": "If all 7 tray slots are occupied without forming a trio of 3 matching tiles, the tray overflows and the game is lost."
    },
    {
      "q": "Can I undo a tile placed in the tray?",
      "a": "Yes! Use the Undo button to return the most recently collected tile from the tray back to its original position on the board."
    }
  ]
